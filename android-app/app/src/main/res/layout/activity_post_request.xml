<?xml version="1.0" encoding="utf-8"?>
<!--
  Mistri · Post Request (redesigned)
  Centerpiece = AI Analysis result card (gradient header, confidence badge,
  PKR price band with emphasised "Recommended").
  ALL original IDs + view types preserved for View Binding / Kotlin:
  toolbar, layoutLoading, ivPreview, tvImageHint, btnCamera, btnGallery,
  etDescription, etCity, btnAnalyze, progressBar, cardResult, tvDetectedClass,
  tvDetectedService, confidenceBar, tvConfidence, tvPriceMin, tvPriceRecommended,
  tvPriceMax, tvPriceRange, tvPriceReason, tvPriceSource, tvLocationName,
  btnPostRequest, progressBarPost.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/colorPrimary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/Theme.Mistri.Toolbar"
            app:title="Post New Request"
            app:titleTextColor="@color/white"
            app:navigationIconTint="@color/white"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F172A"
        android:visibility="gone"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ProgressBar
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:indeterminateTint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_analyzing"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mistri Vision is inspecting your photo"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/colorBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ░░ Photo tips (compact) ░░ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/colorPrimarySurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/colorPrimary"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_photo_tips"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/tv_photo_tips_body"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/textSecondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ░░ Photo capture ░░ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="216dp"
                        android:background="@drawable/bg_upload_dashed">

                        <ImageView
                            android:id="@+id/ivPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Selected damage photo" />

                        <LinearLayout
                            android:id="@+id/tvImageHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/colorPrimary"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_take_or_choose"
                                android:textColor="@color/textSecondary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCamera"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Camera"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_camera"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white"
                            app:cornerRadius="12dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGallery"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Gallery"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimary"
                            app:icon="@drawable/ic_image"
                            app:iconGravity="textStart"
                            app:iconTint="@color/colorPrimary"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ░░ Description ░░ -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:maxLines="5"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ░░ City ░░ -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_city"
                app:startIconDrawable="@drawable/ic_location_pin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ░░ Analyze button ░░ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_analyze"
                android:textAllCaps="false"
                android:enabled="false"
                app:icon="@drawable/ic_ai_spark"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:cornerRadius="14dp" />

            <!-- Legacy progressBar (hidden, replaced by overlay) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- ░░░░░░░░░░ AI RESULT CARD (centerpiece) ░░░░░░░░░░ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Gradient header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_ai_header"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_ai_spark"
                            app:tint="@color/white"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Damage Analysis"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Powered by Mistri Vision"
                                android:textColor="#CFE0FF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@color/onHeroFill"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>

                    <!-- Body -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Detected damage type -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detected damage"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:textAllCaps="true"
                            android:textColor="@color/textHint" />

                        <TextView
                            android:id="@+id/tvDetectedClass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvDetectedService"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimary"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <!-- Confidence -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="18dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Model confidence"
                                android:textSize="13sp"
                                android:textColor="@color/textSecondary" />

                            <TextView
                                android:id="@+id/tvConfidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_confidence_badge"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:drawablePadding="5dp"
                                android:drawableTint="@color/white"
                                app:drawableStartCompat="@drawable/ic_check_circle" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/confidenceBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:progressDrawable="@drawable/bg_confidence_track"
                            android:max="100"
                            android:progress="0" />

                        <!-- Price band -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated cost (PKR)"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:textAllCaps="true"
                            android:textColor="@color/textHint"
                            android:layout_marginTop="22dp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_price_band"
                            android:padding="10dp">

                            <!-- Min -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_min"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary" />

                                <TextView
                                    android:id="@+id/tvPriceMin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="3dp" />
                            </LinearLayout>

                            <!-- Recommended (emphasised) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.25"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_price_recommended"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_recommended"
                                    android:textSize="11sp"
                                    android:textColor="@color/white"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.03" />

                                <TextView
                                    android:id="@+id/tvPriceRecommended"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/white"
                                    android:layout_marginTop="3dp" />
                            </LinearLayout>

                            <!-- Max -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_max"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary" />

                                <TextView
                                    android:id="@+id/tvPriceMax"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="3dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Backward compat: hidden view existing code may set -->
                        <TextView
                            android:id="@+id/tvPriceRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <!-- Justification quote -->
                        <TextView
                            android:id="@+id/tvPriceReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textSize="13sp"
                            android:textStyle="italic"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/textSecondary" />

                        <TextView
                            android:id="@+id/tvPriceSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="11sp"
                            android:textColor="@color/textHint" />

                        <TextView
                            android:id="@+id/tvLocationName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/colorPrimarySurface"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textSize="12sp"
                            android:textColor="@color/colorPrimary"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ░░ Post Request button ░░ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostRequest"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_confirm_post"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@color/statusCompleted"
                app:cornerRadius="14dp" />

            <!-- Post loading -->
            <ProgressBar
                android:id="@+id/progressBarPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
