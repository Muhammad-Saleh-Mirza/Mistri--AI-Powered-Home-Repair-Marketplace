<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Sender avatar (bottom-right) -->
    <ImageView
        android:id="@+id/ivSenderAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_circle_avatar"
        android:backgroundTint="#D97706"
        android:scaleType="centerCrop" />

    <!-- Sent bubble (blue, tail on bottom-right) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="42dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bubbleSent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:lineSpacingMultiplier="1.45" />

            <!-- Location card (shown instead of the text for location messages) -->
            <LinearLayout
                android:id="@+id/layoutLocationCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_location_card_sent"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivLocationPin"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_location_pin_sent"
                    android:padding="8dp"
                    android:src="@drawable/ic_location_pin"
                    android:tint="@color/colorPrimary"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvLocationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_location_card_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvLocationHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_location_card_hint"
                        android:textSize="11sp"
                        android:textColor="#D9FFFFFF"
                        android:layout_marginTop="1dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_location_card_action"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timestamp + read receipt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9.5sp"
                    android:textColor="#B3FFFFFF"
                    android:layout_marginEnd="3dp" />

                <ImageView
                    android:id="@+id/ivReadReceipt"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="#CCFFFFff"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
