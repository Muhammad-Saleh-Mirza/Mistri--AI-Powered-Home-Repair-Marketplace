<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground">

    <!-- ── Gradient chat header ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chat_header"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:elevation="4dp">

        <!-- Back button -->
        <FrameLayout
            android:id="@+id/btnChatBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_header_circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="11dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Avatar circle with initials -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_avatar"
            android:layout_marginEnd="11dp">

            <TextView
                android:id="@+id/tvChatAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark" />
        </FrameLayout>

        <!-- Name + status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatPartnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/viewOnlineDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:backgroundTint="#4ADE80"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChatStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned"
                    android:textSize="10.5sp"
                    android:textColor="#C7FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Phone/call button -->
        <FrameLayout
            android:id="@+id/btnCallContact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_header_circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="9dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone"
                android:tint="@color/white"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── Job context strip ────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorPrimarySurface"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💼"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvJobAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/statusCompleted"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom border on job strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C9DCFA" />

    <!-- ── Content (messages + actions + input) ─────────────────────── -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/colorBackground">

        <!-- Messages list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorBackground"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="8dp" />

        <!-- Contextual action buttons (visibility controlled by state) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <!-- Vendor: Start Journey -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartJourney"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_start_journey"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="11dp"
                app:elevation="0dp"
                app:rippleColor="#33FFFFFF" />

            <!-- Vendor: Mark Complete (green — terminal positive action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkComplete"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_mark_complete"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/statusCompleted"
                app:cornerRadius="11dp"
                app:elevation="0dp"
                app:rippleColor="#33FFFFFF" />

            <!-- Customer: Track Vendor -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackVendor"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_track_vendor"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="11dp"
                app:elevation="0dp"
                app:rippleColor="#33FFFFFF" />

            <!-- Customer: Share my location with the vendor -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnShareLocation"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_share_location"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="11dp" />

            <!-- Vendor: open the location the customer shared -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnViewCustomerLocation"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_view_customer_location"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="11dp" />

            <!-- Customer: Rate Vendor (amber outlined) -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnRateVendor"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="7dp"
                android:text="@string/btn_rate_vendor"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:visibility="gone"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="1.5dp"
                app:cornerRadius="11dp" />

        </LinearLayout>

        <!-- ── Input bar ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorSurface"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:elevation="4dp">

            <!-- Attach button (optional) -->
            <FrameLayout
                android:id="@+id/btnAttach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_vendor_avatar"
                android:backgroundTint="@color/colorPrimarySurface"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="9dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image"
                    android:tint="@color/colorPrimary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Message input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_message"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxStrokeColor="@color/divider"
                app:boxBackgroundColor="@color/colorBackground">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:textSize="13sp"
                    android:background="@null" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Send button (filled circle) -->
            <FrameLayout
                android:id="@+id/btnSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_vendor_avatar"
                android:backgroundTint="@color/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="9dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    android:tint="@color/white"
                    android:contentDescription="@null" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
