<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Map (full screen) ─────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── Floating toolbar gradient overlay ─────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:background="@drawable/bg_tracking_toolbar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:theme="@style/Theme.Mistri.Toolbar" />

        <!-- Extra fade area so the gradient extends below the toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- ── Recenter FAB ───────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fabRecenter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="218dp"
        android:background="@color/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:backgroundTint="@color/colorSurface">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_location_pin"
            android:tint="@color/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- ── Bottom tracking card ──────────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="22dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:strokeColor="@color/divider"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/viewEnRouteDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_vendor_avatar"
                    android:backgroundTint="#FF5722"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EN ROUTE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF5722"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvDistanceEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Getting location…"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:background="@drawable/bg_city_pill"
                    android:backgroundTint="@color/colorPrimarySurface"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- Vendor row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_vendor_avatar"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tvVendorInitialsTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                </FrameLayout>

                <!-- Name + meta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVendorNameTracking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvVendorMetaTracking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- Contact buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp">

                    <FrameLayout
                        android:id="@+id/btnMessageVendor"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="@color/colorPrimarySurface"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_send"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnCallVendor"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="#1A0E9F6E"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/statusCompleted"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Stats divider row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Top border -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@null">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvAcceptedBid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACCEPTED BID"
                            android:textSize="9.5sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvEstDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EST. DURATION"
                            android:textSize="9.5sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider before button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- Go Back button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackFromTracking"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="← Go Back"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
